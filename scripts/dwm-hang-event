#!/usr/bin/env bash
# Called by dwm when a window stops answering _NET_WM_PING ("hung"), answers
# again ("recovered"), or is closed while hung ("gone"). Arguments come from the
# client: treat them as data only.
set -euo pipefail

state=${1:-}
window=${2:-}
pid=${3:-0}
class=${4:-}
title=${5:-}

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/dwm-titus
ignore_file=$config_dir/hang-ignore
runtime=${XDG_RUNTIME_DIR:-/run/user/$UID}/dwm-titus/hang

[[ $window =~ ^0x[0-9a-f]+$ ]] || exit 2
[[ $pid =~ ^[0-9]+$ ]] || pid=0
command -v notify-send >/dev/null 2>&1 || exit 0

mkdir -p "$runtime"
record=$runtime/$window
# Start time (field 22 of /proc/<pid>/stat). The name in field 2 can contain
# spaces and parentheses, so read everything after its closing parenthesis.
start_time_of() {
	local stat fields
	stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 0
	read -ra fields <<<"${stat##*) }"
	printf '%s' "${fields[19]:-}"
}

# dwm starts a handler per event and they can run out of order, so each one
# notes when dwm started it (process start time, in clock ticks). recovered and
# gone leave that time here; a hung handler started before it stands down.
closed_marker=$runtime/$window.closed
self_start=$(start_time_of $$)

same_process() {
	local now
	now=$(start_time_of "$pid")
	[[ -n $now && $now == "$start_time" ]] && echo yes || echo no
}

recovered_since_hung() {
	local closed_at=''
	[[ -f $closed_marker ]] || return 1
	read -r closed_at <"$closed_marker" || return 1
	[[ $closed_at =~ ^[0-9]+$ ]] && ((closed_at >= self_start))
}

ignored() {
	local line
	[[ -n $class && -f $ignore_file ]] || return 1
	while IFS= read -r line; do
		line=${line%%#*}
		line=${line//[[:space:]]/}
		[[ -n $line && ${line,,} == "${class,,}" ]] && return 0
	done <"$ignore_file"
	return 1
}

close_id() {
	[[ ${1:-} =~ ^[1-9][0-9]*$ ]] || return 0
	gdbus call --session --dest org.freedesktop.Notifications \
		--object-path /org/freedesktop/Notifications \
		--method org.freedesktop.Notifications.CloseNotification "$1" >/dev/null 2>&1 || true
}

close_notification() {
	local id='' waiter=''
	printf '%s\n' "$self_start" >"$closed_marker"
	[[ -f $record ]] || return 0
	read -r id waiter <"$record" || true
	rm -f "$record"
	[[ $waiter =~ ^[0-9]+$ ]] && kill "$waiter" 2>/dev/null || true
	close_id "$id"
}

case $state in
recovered | gone)
	close_notification
	exit 0
	;;
hung) ;;
*) exit 2 ;;
esac

ignored && exit 0
# One notification per hang, even if dwm reports it again.
[[ -f $record ]] && exit 0
recovered_since_hung && exit 0

name=${class:-${title:-Window}}
name=${name//[$'\t\r\n']/ }
name=${name:0:60}

if [[ -n $(dwm-agent default 2>/dev/null) ]]; then
	diagnose_label="Diagnose with AI"
else
	diagnose_label="Set up AI diagnosis"
fi

# Remember which process this is now, so Force quit never kills a process that
# reused the PID while the notification was waiting.
start_time=''
if ((pid > 0)) && [[ -O /proc/$pid ]]; then
	start_time=$(start_time_of "$pid")
fi

# notify-send prints the notification id first and, after the click, the
# action. A plain file (not a FIFO) means killing it can never leave this
# handler blocked.
out=$runtime/$window.out
: >"$out"
notify-send --app-name=dwm-titus --urgency=critical --print-id \
	--action=diagnose="$diagnose_label" --action=kill="Force quit" --action=wait=Wait \
	"$name is not responding" \
	"It has not answered for 10 seconds. It may still recover." >"$out" 2>/dev/null &
waiter=$!
printf '0 %s\n' "$waiter" >"$record"
id=''
for _ in {1..50}; do
	read -r id <"$out" || id=''
	[[ -n $id ]] && break
	kill -0 "$waiter" 2>/dev/null || break
	sleep 0.1
done
[[ -f $record ]] && printf '%s %s\n' "${id:-0}" "$waiter" >"$record"
# The window answered while the notification was being posted.
if recovered_since_hung; then
	rm -f "$record" "$out"
	kill "$waiter" 2>/dev/null || true
	close_id "$id"
	exit 0
fi
wait "$waiter" 2>/dev/null || true
action=$(sed -n 2p "$out")
rm -f "$record" "$out"

case $action in
diagnose)
	setsid -f dwm-agent-diagnose hang "$window" "$pid" "$class" </dev/null >/dev/null 2>&1
	;;
kill)
	# XKillClient through xdotool closes the client's X connection; it works
	# for sandboxed apps where the PID would point at the wrong process.
	xdotool windowkill "$window" 2>/dev/null || exit 0
	# A process that is truly stuck never notices its connection closing.
	if [[ -n $start_time ]]; then
		sleep 5
		if [[ -O /proc/$pid ]] && [[ $(same_process) == yes ]]; then
			kill -KILL "$pid" 2>/dev/null || true
		fi
	fi
	;;
esac
