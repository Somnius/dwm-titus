#!/usr/bin/env bash
# Pick, install, log in to, and launch the AI coding agent used for
# "Diagnose with AI". The diagnosis method itself lives in the dwm-titus-debug
# skill so every agent follows the same steps.
set -euo pipefail

AGENTS=(codex opencode gemini)

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/dwm-titus
data_dir=${XDG_DATA_HOME:-$HOME/.local/share}/dwm-titus
agent_file=$config_dir/agent
hang_toggle=$config_dir/hang-detection
crash_off_toggle=$config_dir/crash-notifications-off
# The dwm-titus-ai-skills package can ship newer skills than the desktop.
skills_source=$data_dir/config/agents/skills
[[ -d /usr/share/dwm-titus/agents/skills ]] && skills_source=/usr/share/dwm-titus/agents/skills
# Codex, OpenCode and Gemini CLI all read skills from here.
skills_target=$HOME/.agents/skills
mise_shims=${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims

usage() {
	cat <<'EOF'
Usage: dwm-agent [--inline] [--prompt TEXT]
       dwm-agent default [codex|opencode|gemini]
       dwm-agent setup
       dwm-agent install <codex|opencode|gemini>
       dwm-agent login [codex|opencode|gemini]
       dwm-agent link-skills
       dwm-agent status
       dwm-agent set <crash-notifications|hang-detection> <on|off>
EOF
}

die() {
	printf 'dwm-agent: %s\n' "$*" >&2
	exit 1
}

known_agent() {
	local agent
	for agent in "${AGENTS[@]}"; do
		[[ $agent == "$1" ]] && return 0
	done
	return 1
}

agent_name() {
	case $1 in
	codex) printf 'Codex' ;;
	opencode) printf 'OpenCode' ;;
	gemini) printf 'Gemini CLI' ;;
	esac
}

# mise tools to install for each agent, in order.
agent_tools() {
	case $1 in
	codex) printf '%s\n' codex ;;
	opencode) printf '%s\n' opencode ;;
	gemini) printf '%s\n' node@lts npm:@google/gemini-cli ;;
	esac
}

current_agent() {
	local agent=''
	[[ -f $agent_file ]] && read -r agent <"$agent_file" || true
	known_agent "$agent" && printf '%s\n' "$agent"
	return 0
}

use_mise_path() {
	[[ :$PATH: == *":$mise_shims:"* ]] || PATH=$mise_shims:$PATH
	export PATH
}

agent_present() {
	use_mise_path
	command -v "$1" >/dev/null 2>&1
}

set_default() {
	known_agent "$1" || die "unknown agent '$1' (choose: ${AGENTS[*]})"
	mkdir -p "$config_dir"
	printf '%s\n' "$1" >"$agent_file.tmp"
	mv -f "$agent_file.tmp" "$agent_file"
}

# Package installation is for Fedora only, like the rest of dwm-titus.
require_fedora() {
	local id=''
	[[ -r /etc/os-release ]] && id=$(sed -n 's/^ID=//p' /etc/os-release | tr -d "\"'")
	[[ $id == fedora ]] || die "agent installation is supported on Fedora only (found '${id:-unknown}')"
}

ensure_mise() {
	command -v mise >/dev/null 2>&1 && return 0
	cat <<'EOF'
mise is needed to install the agent. It comes from the official mise
repository (https://mise.jdx.dev/rpm), added to dnf with its signing key.
This runs:
  sudo dnf config-manager addrepo --from-repofile=https://mise.jdx.dev/rpm/mise.repo
  sudo dnf install mise
EOF
	confirm "Install mise now?" yes || die "mise is required; install it and run 'dwm-agent setup' again"
	if ! dnf repolist --enabled 2>/dev/null | grep -q '^mise-repo'; then
		sudo dnf config-manager addrepo --from-repofile=https://mise.jdx.dev/rpm/mise.repo
	fi
	sudo dnf install -y mise
}

install_agent() {
	local agent=$1 tool
	known_agent "$agent" || die "unknown agent '$agent'"
	require_fedora
	ensure_mise
	while IFS= read -r tool; do
		printf '==> mise use -g %s\n' "$tool"
		mise use -g "$tool"
	done < <(agent_tools "$agent")
	agent_present "$agent" || die "$(agent_name "$agent") did not install"
}

# Each agent's own login. Codex and OpenCode open the default browser; Gemini
# CLI asks how to sign in on its first interactive start.
login_agent() {
	local agent=$1
	use_mise_path
	case $agent in
	codex) codex login ;;
	opencode) opencode auth login ;;
	gemini)
		printf 'Gemini CLI signs in on its first start. Pick "Login with Google",\n'
		printf 'finish in the browser, then type /quit.\n'
		gemini
		;;
	esac
}

link_skills() {
	local skill name target
	[[ -d $skills_source ]] || die "no skills in $skills_source"
	mkdir -p "$skills_target"
	for skill in "$skills_source"/*/; do
		name=$(basename "$skill")
		target=$skills_target/$name
		if [[ -e $target && ! -L $target ]]; then
			printf 'Keeping %s; it is not a link made by dwm-titus.\n' "$target" >&2
			continue
		fi
		ln -sfn "${skill%/}" "$target"
	done
}

confirm() {
	local question=$1 default=$2 reply
	if [[ $default == yes ]]; then
		read -r -p "$question [Y/n] " reply || reply=
		[[ -z $reply || $reply == [Yy]* ]]
	else
		read -r -p "$question [y/N] " reply || reply=
		[[ $reply == [Yy]* ]]
	fi
}

setup() {
	local agent choice i
	printf 'Diagnose with AI: setup\n\n'
	printf 'Which agent should dwm-titus open when you ask for a diagnosis?\n'
	for i in "${!AGENTS[@]}"; do
		agent=${AGENTS[$i]}
		printf '  %d) %s%s\n' "$((i + 1))" "$(agent_name "$agent")" \
			"$(agent_present "$agent" && printf ' (installed)')"
	done
	read -r -p "Choice [1-${#AGENTS[@]}]: " choice
	if ! [[ $choice =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#AGENTS[@]})); then
		die "no agent chosen"
	fi
	agent=${AGENTS[$((choice - 1))]}

	agent_present "$agent" || install_agent "$agent"
	set_default "$agent"
	link_skills

	if confirm "Log in to $(agent_name "$agent") now?" yes; then
		login_agent "$agent"
	fi

	printf '\nCrash notifications tell you when one of your programs crashes and\n'
	printf 'offer to diagnose it.\n'
	if confirm "Keep crash notifications on?" yes; then
		rm -f "$crash_off_toggle"
	else
		: >"$crash_off_toggle"
	fi

	cat <<'EOF'

Hang detection makes dwm check every few seconds that windows still answer.
A window that stops answering for 10 seconds gets a "not responding"
notification with Diagnose with AI / Force quit / Wait.

It can be wrong: games, virtual machines and apps that are busy on purpose
(big exports, compiles) can show up as not responding when they are fine.
You can turn it off again in Settings or with: rm ~/.config/dwm-titus/hang-detection
EOF
	if confirm "Turn on hang detection?" no; then
		: >"$hang_toggle"
	else
		rm -f "$hang_toggle"
	fi
	printf '\nDone. Default agent: %s\n' "$(agent_name "$agent")"
}

status() {
	local agent
	agent=$(current_agent)
	printf 'agent\t%s\n' "${agent:-none}"
	for agent in "${AGENTS[@]}"; do
		printf 'installed\t%s\t%s\n' "$agent" "$(agent_present "$agent" && echo yes || echo no)"
	done
	printf 'crash-notifications\t%s\n' "$([[ -e $crash_off_toggle ]] && echo off || echo on)"
	printf 'hang-detection\t%s\n' "$([[ -e $hang_toggle ]] && echo on || echo off)"
	printf 'skills\t%s\n' "$([[ -L $skills_target/dwm-titus-debug ]] && echo linked || echo missing)"
}

set_toggle() {
	local name=$1 value=$2 file create
	case $value in
	on | off) ;;
	*) die "value must be on or off, not '$value'" ;;
	esac
	case $name in
	crash-notifications)
		file=$crash_off_toggle
		create=off
		;;
	hang-detection)
		file=$hang_toggle
		create=on
		;;
	*) die "unknown setting '$name' (choose: crash-notifications hang-detection)" ;;
	esac
	mkdir -p "$config_dir"
	if [[ $value == "$create" ]]; then
		: >"$file"
	else
		rm -f "$file"
	fi
}

# Agents opened from a notification run unattended, each with its own flag
# for "don't stop to ask".
launch() {
	local inline=0 prompt='' agent
	local -a command
	while (($#)); do
		case $1 in
		--inline)
			inline=1
			shift
			;;
		--prompt)
			(($# >= 2)) || die "--prompt needs a value"
			prompt=$2
			shift 2
			;;
		*) die "unexpected argument: $1" ;;
		esac
	done

	agent=$(current_agent)
	if [[ -z $agent ]]; then
		((inline)) && die "no agent chosen; run: dwm-agent setup"
		exec dwm-terminal -e "$0" setup
	fi
	agent_present "$agent" || die "$(agent_name "$agent") is not installed; run: dwm-agent install $agent"

	case $agent in
	codex)
		command=(codex --approve-for-me)
		[[ -n $prompt ]] && command+=(-- "$prompt")
		;;
	opencode)
		command=(opencode --auto)
		[[ -n $prompt ]] && command+=(--prompt "$prompt")
		;;
	gemini)
		command=(gemini --yolo)
		[[ -n $prompt ]] && command+=(--prompt-interactive "$prompt")
		;;
	esac

	cd "$HOME"
	if ((inline)); then
		exec "${command[@]}"
	fi
	exec dwm-terminal -e "${command[@]}"
}

case ${1:-} in
-h | --help) usage ;;
default)
	if (($# > 1)); then set_default "$2"; else current_agent; fi
	;;
setup) setup ;;
install)
	(($# == 2)) || die "usage: dwm-agent install <${AGENTS[*]}>"
	install_agent "$2"
	;;
login)
	agent=${2:-$(current_agent)}
	[[ -n $agent ]] || die "no agent chosen; run: dwm-agent setup"
	known_agent "$agent" || die "unknown agent '$agent'"
	login_agent "$agent"
	;;
link-skills) link_skills ;;
status) status ;;
set)
	(($# == 3)) || die "usage: dwm-agent set <crash-notifications|hang-detection> <on|off>"
	set_toggle "$2" "$3"
	;;
*) launch "$@" ;;
esac
